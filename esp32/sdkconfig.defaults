# ESP32-C6 DevKitC-1 doorlock firmware defaults

# BLE / NimBLE
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_MAX_BONDS=3
# 본딩 키를 NVS에 저장. 꺼두면 재부팅마다 ESP32 LTK가 날아가
# 앱(Android)에만 페어링이 남아 재연결 시 암호화가 실패한다.
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# WiFi
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# mDNS for homeassistant.local resolution
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y

# HTTP client
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# TLS certificate bundle: use CA callback path to handle cross-signed chains
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# NVS
CONFIG_NVS_ENCRYPTION=n

# Partition table: large single app (~3 MB factory, fits BLE+WiFi firmware)
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
