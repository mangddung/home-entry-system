# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5000/auth/kakao/callback

# JWT
JWT_SECRET=

MASTER_KEK=

ADMIN_SECRET=

SETUP_SERVICE_UUID=
SETUP_WRITE_UUID=
SETUP_READ_UUID=

FIREBASE_CREDENTIAL_PATH=

# Zigbee 모델 MQTT 브로커 (docker-compose의 Mosquitto)
MQTT_HOST=127.0.0.1
MQTT_PORT=15883
MQTT_USER=
MQTT_PASSWORD=

# 초대 App Links 검증 (/.well-known/assetlinks.json). 지문은 릴리스 서명 키의 SHA-256, 쉼표로 여러 개
ANDROID_PACKAGE=com.iotapp
ANDROID_CERT_FINGERPRINTS=